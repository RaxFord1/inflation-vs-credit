# Скопіюй у .env та заповни. Файл .env у .gitignore — ключі не потраплять у git.

# --- OpenAI (оцінка угод + аналіз фото, gpt-4o-mini) ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# --- DOM.RIA офіційний API ключ ---
# Отримати безкоштовно: https://developers.ria.com/ (реєстрація -> кабінет -> API key)
DOMRIA_API_KEY=

# --- Telegram нотифаєр ---
# 1) Створи бота у @BotFather -> отримаєш токен
# 2) Напиши боту будь-що, потім відкрий https://api.telegram.org/bot<TOKEN>/getUpdates щоб узнати свій chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Необовʼязково ---
# Проксі для скрапінгу (щоб не світити один IP). Формат: http://user:pass@host:port
HTTP_PROXY=
LOG_LEVEL=info
